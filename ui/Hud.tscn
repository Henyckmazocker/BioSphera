[node name="HelpLabel" type="Label" parent="Root/HelpPanel/HelpMargin/HelpVBox"]
unique_name_in_owner = true
text = "Espacio    pausa
1·2·3·4·5  velocidad x1 / x2 / x4 / x8 / x16
P          panel de parámetros globales
S          panel de modificadores por especie
T          panel de estadísticas
V          eventos del entorno
E          modo experimentación (dios)
H          ocultar / mostrar toda la UI
K          ocultar / mostrar esta ayuda
N          navmesh (debug)
O          territorio (especie / grupo)
F5         guardar partida

Click izq  seleccionar esfera
F          enfocar selección
WASD       paneo cámara
Click med  paneo arrastrando
Click der  orbitar
Rueda      zoom
R          reset cámara"
modulate = Color(1, 1, 1, 0.85)

