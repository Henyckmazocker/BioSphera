[gd_resource type="Resource" script_class="SimPreset" load_steps=7 format=3]

[ext_resource type="Script" path="res://data/sim_preset.gd" id="1_preset"]
[ext_resource type="Script" path="res://data/environment_event.gd" id="2_event"]
[ext_resource type="Resource" path="res://data/events/sequia.tres" id="3_sequia"]
[ext_resource type="Resource" path="res://data/events/ola_de_frio.tres" id="4_frio"]
