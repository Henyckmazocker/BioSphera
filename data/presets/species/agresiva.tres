[gd_resource type="Resource" script_class="SpeciesPreset" load_steps=2 format=3]

[ext_resource type="Script" path="res://data/species_preset.gd" id="1_species"]

[resource]
script = ExtResource("1_species")
id = &"agresiva"
display_name = "Agresiva"
description = "Belicosa y poco leal: mucha agresividad y valentía, baja lealtad. Inicia combates con facilidad y tiende al conflicto interno; potente pero propensa a la autodestrucción si no domina a sus rivales."
trait_means = {
&"aggression": 0.8,
&"sociability": 0.4,
&"loyalty": 0.35,
&"bravery": 0.7,
&"reproductive_appetite": 0.6,
&"selectivity": 0.5,
&"territoriality": 0.6
}
species_mods = {
&"aggression": 1.3,
&"metabolism": 1.1
}
