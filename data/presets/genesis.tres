[gd_resource type="Resource" script_class="SimPreset" load_steps=2 format=3]

[ext_resource type="Script" path="res://data/sim_preset.gd" id="1_preset"]

[resource]
script = ExtResource("1_preset")
id = &"genesis"
display_name = "Génesis"
description = "Caja de Petri: una población pequeña y homogénea con comida abundante y sin presión. El punto de partida más limpio para observar la evolución desde cero."
